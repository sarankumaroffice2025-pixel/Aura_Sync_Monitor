COLUMN TABLE "EVENTS" (
    "ID" NVARCHAR(36) NOT NULL,
    "EVENT_ID" NVARCHAR(100),
    "EVENT_TYPE" NVARCHAR(100),
    "OBJECT_ID" NVARCHAR(200),
    "OBJECT_TYPE" NVARCHAR(100),
    "VERSION" INTEGER,
    "LEAD_SYSTEM" NVARCHAR(100),
    "SITE_ID" NVARCHAR(100),
    "CORRELATION_ID" NVARCHAR(100),
    "EVENT_TIMESTAMP" TIMESTAMP,
    "RECEIVED_AT" TIMESTAMP NOT NULL,
    "CHANGED_FIELDS" NCLOB,
    "PAYLOAD" NCLOB,
    PRIMARY KEY ("ID")
)
